App.DisplayName=AssettoServer
App.RootDir=
App.WorkingDir=
App.ExecutableLinux=AssettoServer
App.HasWriteableConsole=true
App.HasReadableConsole=true
App.Compatibility=1
App.ApplicationPort1=9600
App.ApplicationPort2=8081
App.CommandLineArgs=
App.EnvironmentVariables={"DOTNET_SYSTEM_GLOBALIZATION_INVARIANT":"1","ASPNETCORE_URLS":"http://0.0.0.0:{{$ApplicationPort2}}"}
App.ExitMethod=SIGTERM
App.MaxUsers=16
App.UpdateSources=[{"UpdateStageName":"Baixar AssettoServer v0.0.54 (Linux x64)","UpdateSourcePlatform":"Linux","UpdateSource":"GithubRelease","UpdateSourceArgs":"compujuckel/AssettoServer","UpdateSourceData":"assetto-server-linux-x64.tar.gz","UpdateSourceVersion":"v0.0.54","UnzipUpdateSource":true,"OverwriteExistingFiles":true},{"UpdateStageName":"Marcar binário como executável","UpdateSourcePlatform":"Linux","UpdateSource":"SetExecutableFlag","UpdateSourceArgs":"AssettoServer"}]
Console.AppReadyRegex=^.*(?:Started AssettoServer|Listening on port|Server started).*$
Console.UserJoinRegex=^.*\[INFO\].*?(?<username>.+?)\s+\(\d+\)\s+joined.*$
Console.UserLeaveRegex=^.*(?<username>.+?)\s+disconnected.*$
Console.UserChatRegex=^.*\[CHAT\]\s+(?<username>.+?):\s+(?<message>.+)$
Console.ThrowawayMessageRegex=^.*(?:Heartbeat|KeepAlive|GarbageCollect|System\.Threading).*$
Meta.DisplayName=AssettoServer (compujuckel)
Meta.Description=Custom Assetto Corsa server focused on freeroam, with AI traffic, dynamic weather and security fixes. Community fork by compujuckel.
