Meta.DisplayName=AssettoServer (compujuckel)
Meta.Description=Custom Assetto Corsa server focused on freeroam, with AI traffic, dynamic weather and security fixes. Community fork by compujuckel.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=compujuckel / marcioeric
Meta.URL=https://github.com/compujuckel/AssettoServer
Meta.DisplayImageSource=url:https://assettoserver.org/img/logo.png
Meta.ConfigManifest=assettoserverconfig.json
Meta.MetaConfigManifest=assettoservermetaconfig.json
Meta.ConfigRoot=assettoserver.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=marcioeric/assettoserver-amp:latest
Meta.DockerRequired=False
Meta.ContainerPolicy=RequiredOnLinux
Meta.ContainerPolicyReason=Requires .NET 8 runtime and AssettoServer binary pre-installed in image.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.AppConfigId=a1b2c3d4-e5f6-7890-abcd-ef1234567890
Meta.AppIsMultiIPAware=False

App.DisplayName=AssettoServer
App.RootDir=
App.ExecutableLinux=AssettoServer
App.WorkingDir=
App.CommandLineArgs=
App.AppSettings={}
App.EnvironmentVariables={}
App.ExitMethod=SIGTERM
App.ExitTimeout=30
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.MaxUsers=16
App.ApplicationPort1=9600
App.ApplicationPort2=8081
App.UpdateSources=@IncludeJson[assettoserverupdates.json]
App.Compatibility=LinuxBufferedConsole
App.RapidStartup=False
App.ApplicationReadyMode=RegexMatch

Console.AppReadyRegex=^.*(?:Listening on|Server running|AssettoServer.*started).*$
Console.UserJoinRegex=^.*\[INF\].*(?<username>.+?) connected.*$
Console.UserLeaveRegex=^.*\[INF\].*(?<username>.+?) disconnected.*$
Console.UserChatRegex=^.*\[CHAT\]\s+(?<username>.+?):\s+(?<message>.+)$
Console.ThrowawayMessageRegex=^$

Limits.SleepMode=False
Limits.AutoRetryCount=3
